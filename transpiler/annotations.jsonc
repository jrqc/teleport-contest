// transpiler/annotations.jsonc: representation and call-graph decisions that
// override the analyzer's defaults (method/design.md section 9).
// Keys are C names: "struct x" / "union u" for records, function names (or
// "file::name" for static functions). Every entry says why. Checked by
// transpiler/annotations/check.mjs on every transpile.
{
  "groups": {
    // design 3.5 / 7, decision D2: the Lua VM is raw memory throughout
    // defines: lvm.c's computed-goto dispatch (ljumptab.h, on by default under
    // __GNUC__) and its switch fallback run the same opcode bodies in the same
    // order (lvm.c vmdispatch/vmcase); the switch is the one JS can express
    "lua": { "files": "lib/lua-5.4.8/src/", "repr": "heap",
             "defines": ["-DLUA_USE_JUMPTABLE=0"],
             "why": "value-stack pointer arithmetic, GC unions and casts, offsetof, computed goto" },
    // postmortem F2: the recorder's regcomp/regexec are Darwin Libc's (TRE); the
    // vendored sources (transpiler/third_party/README.md) are raw memory like Lua's
    "darwin-regex": { "files": "transpiler/third_party/darwin-", "repr": "heap",
                      "why": "TRE: unions, pointer casts, its own allocator; behind the same C API bridge as Lua" },
    // contract (docs/API.md): rng.js must use the frozen ISAAC64 implementation.
    // Its JS signatures differ from C's (isaac64_init(seed_bytes) returns the
    // context), so calls go through a small hand-written adapter.
    "isaac64": { "files": "src/isaac64.c", "repr": "extern", "module": "js/isaac64.js",
                 "adapter": "js/crt/isaac64-glue.js",
                 "why": "frozen file overlaid by the judge" }
  },
  "types": {
    // design 3.5, decision D4
    "struct engr": {
      "repr": "object",
      "tail": { "alloc": "newengr", "space": "engr_text_space" },
      "why": "text buffers live in the same allocation after the struct (engrave.c newengr); modeled as a trailing byte area so engr_txt[] stay real byte pointers"
    }
    // Unions: no entries. The punning check (transpiler/out/union-pun.md) decides;
    // an entry here could only move a union to "object" with an approved
    // "discriminant" (design 3.4).
  },
  "functions": {
    // patch 002: byte arithmetic on an arbitrary base (base + idx * size) and a byte-copy
    // permutation; the override keeps the algorithm (index sort with Darwin qsort, ties by
    // index) and moves elements by value. Async twin for comparators in the async set.
    "nh_deterministic_qsort": { "handwritten": "js/crt/qsort.js", "c": "src/hacklib.c", "csha": "8d897f33de168cc9",
                                "why": "byte pointer arithmetic over an untyped base; see the comment in js/crt/qsort.js" },
    // design 7.3: one allocator for two memories (NetHack's nud record, and every
    // Lua object through lua_Alloc); the override has an object-world face and a
    // heap-world face ($heap) the bridge hands to lua_newstate
    "src/nhlua.c::nhl_alloc": { "handwritten": "js/hand/nhlua.js", "c": "src/nhlua.c", "csha": "d2c4c38939beb4e5",
                            "why": "allocates heap-world memory for Lua and object-world memory for NetHack" },
    // the recorder fork()s and execv()s /usr/bin/compress at every save and restore; the
    // override keeps the parent's C code and models the child by its observable effects
    "src/files.c::docompress_file": { "handwritten": "js/hand/files.js", "c": "src/files.c", "csha": "2154351b20f53c30",
                                      "why": "fork/exec of an external compressor; see the comment in js/hand/files.js" }
  },
  "pointers": {},
  "edges": { "cut": [] }
}
